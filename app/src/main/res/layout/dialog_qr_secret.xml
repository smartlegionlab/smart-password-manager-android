<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#1E1E1E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔐 Verify Secret Phrase"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the secret phrase for this QR code to verify ownership"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/lengthInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔢 Password length: --"
        android:textSize="13sp"
        android:textColor="#4CAF50"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/keyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔑 Public key: --"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginBottom="16dp"
        android:fontFamily="monospace" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/secretLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Secret phrase"
        app:endIconMode="password_toggle"
        app:boxBackgroundMode="outline"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/secretPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:backgroundTint="#666666" />

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Verify &amp; Continue"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3" />
    </LinearLayout>

</LinearLayout>